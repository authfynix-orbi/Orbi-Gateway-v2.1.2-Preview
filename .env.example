# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where ORBI Talk Gateway is hosted.
APP_URL="https://talk.orbifinancial.com"
VITE_APP_URL="https://talk.orbifinancial.com"
PUBLIC_GATEWAY_BASE_URL="https://talk.orbifinancial.com"
ORBI_TALK_GATEWAY_URL="https://talk.orbifinancial.com"

# ORBI_TALK_GATEWAY_API_KEY: The secret key used to secure ORBI Talk APIs for external connections.
ORBI_TALK_GATEWAY_API_KEY="your-super-secret-orbi-talk-key"

# EMAIL DELIVERY
# ORBI_TALK_EMAIL_PROVIDER: "resend" or "smtp". Prefer template-driven /api/send-template with channel="email".
ORBI_TALK_EMAIL_PROVIDER="resend"
ORBI_TALK_EMAIL_FROM="ORBI Financial <no-reply@orbifinancial.com>"
# Leave Reply-To empty when Cloudflare Email Routing should route replies to the From alias.
ORBI_TALK_EMAIL_REPLY_TO=""
# Display names and candidate sender emails are supplied dynamically by trusted vendor/template data.
# Every vendor address must be provider-verified and listed here before the gateway will use it.
ORBI_TALK_EMAIL_ALLOWED_FROM="ORBI Financial <no-reply@orbifinancial.com>,ORBI Financial <notifications@orbifinancial.com>,ORBI Support <support@orbifinancial.com>,ORBI Sales <sales@orbifinancial.com>,shop@orbifinancial.com,offers@orbifinancial.com,sellers@orbifinancial.com,ORBI Security <security@orbifinancial.com>,ORBI Admin <admin@orbifinancial.com>,ORBI Info <info@orbifinancial.com>"

# Trusted ORBI product clients should keep their own API key names in their runtime env.
# Example product backend: ORBI_PRODUCT_TALK_API_KEY="<generated scoped Talk API credential>"

# Resend-compatible provider
ORBI_TALK_RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"

# SMTP provider alternative
ORBI_TALK_SMTP_HOST=""
ORBI_TALK_SMTP_PORT="587"
ORBI_TALK_SMTP_SECURE="false"
ORBI_TALK_SMTP_USER=""
ORBI_TALK_SMTP_PASS=""

# Legacy compatibility. Prefer ORBI_TALK_GATEWAY_API_KEY for new deployments.
ORBI_GATEWAY_API_KEY=""

# SELF_KEEPALIVE_INTERVAL_MS: Optional internal keepalive interval for queue-health self-pings.
# Minimum enforced value is 30000 ms. Default is 30000 ms (30 seconds).
SELF_KEEPALIVE_INTERVAL_MS="30000"

# FIREBASE ADMIN (For Backend Operations)
# Generate a new private key from Firebase Console -> Project Settings -> Service Accounts
# Paste the ENTIRE JSON string here.
FIREBASE_SERVICE_ACCOUNT_KEY='{ "type": "service_account", "project_id": "YOUR_PROJECT_ID", ... }'
